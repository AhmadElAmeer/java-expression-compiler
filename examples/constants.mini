// Written to show constant folding: the loop body is full of expressions the compiler can
// work out in advance. Real code is rarely this kind, so treat this as the best case.
let secondsPerDay = 60 * 60 * 24;
let total = 0;
let i = 0;
while (i < 200000) {
    total = total + (i % 7) * (1000 / 8) + (2 * 3 + 4) - secondsPerDay % 1000;
    if (1 < 2 && !false) {
        total = total + 1;
    }
    i = i + 1;
}
print total;
