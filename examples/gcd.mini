// Sum of gcd(i, j) for 1 <= i, j < 300, using Euclid's algorithm.
fn gcd(a: int, b: int): int {
    while (b != 0) {
        let t = a % b;
        a = b;
        b = t;
    }
    return a;
}

let total = 0;
let i = 1;
while (i < 300) {
    let j = 1;
    while (j < 300) {
        total = total + gcd(i, j);
        j = j + 1;
    }
    i = i + 1;
}
print total;
