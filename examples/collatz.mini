// The start below 30,000 with the longest Collatz sequence, and that sequence's length.
fn steps(n: int): int {
    let s = 0;
    while (n != 1) {
        if (n % 2 == 0) {
            n = n / 2;
        } else {
            n = 3 * n + 1;
        }
        s = s + 1;
    }
    return s;
}

let best = 1;
let bestSteps = 0;
let i = 1;
while (i < 30000) {
    let s = steps(i);
    if (s > bestSteps) {
        best = i;
        bestSteps = s;
    }
    i = i + 1;
}
print best;
print bestSteps;
