// Count the primes below 60,000 by trial division.
fn isPrime(n: int): bool {
    if (n < 2) {
        return false;
    }
    let d = 2;
    while (d * d <= n) {
        if (n % d == 0) {
            return false;
        }
        d = d + 1;
    }
    return true;
}

let count = 0;
let n = 2;
while (n < 60000) {
    if (isPrime(n)) {
        count = count + 1;
    }
    n = n + 1;
}
print count;
